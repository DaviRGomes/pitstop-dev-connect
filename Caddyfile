# Todo o tráfego chega pelo proxy do Cloudflare. Confiar nas faixas dele faz o Caddy
# usar o IP real do visitante (CF-Connecting-IP) e repassar X-Forwarded-For correto
# para os apps, em vez do IP do Cloudflare. Faixas oficiais:
# https://www.cloudflare.com/ips-v4 e https://www.cloudflare.com/ips-v6 (conferidas em 2026-11-17).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Um endereço só para o Google: o www redireciona (301) para o domínio sem www,
# mantendo caminho e query, em vez de servir uma cópia do site.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	# Os nomes gerados pelo Vite têm hash de conteúdo e podem ser imutáveis.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Assets de marca mantêm nomes estáveis; revalide com frequência moderada.
	@brand path /brand/*
	header @brand Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# Figuras dos guias e fontes: nomes estáveis, trocam pouco; mesmo critério da marca.
	@static path /guides/* /fonts/*
	header @static Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# API de F1 e imagens de pista → container do backend (server/, porta 3333)
	@api path /api/* /tracks/*
	handle @api {
		reverse_proxy api-prod:3333
	}

	# Todo o resto → app SSR (Nitro node-server, porta 3005)
	handle {
		reverse_proxy app:3005
	}
}

portal.pitstop.dev.br {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy portal-api:3000
	}

	handle {
		reverse_proxy portal-web:8080
	}
}

# Finance App (repo Financeiro, /opt/finance-app). O nginx do finance publica a porta 8992
# no host; o caddy alcança pelo gateway do docker0 (as redes Docker dos dois projetos são
# separadas). TLS termina aqui; o nginx do finance segue em HTTP puro só no host.
financas.pitstop.dev.br {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy 172.17.0.1:8992
}
