# Porta HTTP
PORT=3333

# Origins adicionais separados por vírgula. Localhost:3005 e :5173 já são aceitos.
CORS_ORIGINS=https://pitstop.dev.br

# Gere um valor longo e aleatório. Vazio desativa POST /api/cache/clear.
CACHE_CLEAR_TOKEN=

# Cache em memória: aceita de 16 a 5000 entradas.
CACHE_MAX_ENTRIES=256

# Timeout (500..60000 ms) e retries de GET (0..3) para APIs externas.
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_GET_RETRIES=1

# OpenF1: use um token direto OU o par usuário/senha para OAuth gerenciado.
OPENF1_ACCESS_TOKEN=
OPENF1_USERNAME=
OPENF1_PASSWORD=
