# Public hostname used by Caddy in the production Docker Compose profile.
DOMAIN=pitstop.dev.br

# Build-time URL for the browser-facing F1 API. Leave empty for same-origin.
VITE_PITSTOP_API=

# Optional build-time CDN URL for the home background video.
VITE_SENNA_BG_URL=

# Optional backend tuning. An empty cache token disables the clear endpoint.
CORS_ORIGINS=
CACHE_CLEAR_TOKEN=
CACHE_MAX_ENTRIES=256
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_GET_RETRIES=1

# Optional OpenF1 authentication. Prefer a direct token, or provide both
# username and password for managed OAuth. Never commit real credentials.
OPENF1_ACCESS_TOKEN=
OPENF1_USERNAME=
OPENF1_PASSWORD=
